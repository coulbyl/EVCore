# ──────────────────────────────────────────────
# EVCore Backend — Environment Variables Template
# Copy to .env and fill in real values.
# Never commit .env — only .env.example.
# ──────────────────────────────────────────────

# ── Server ────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
# Allowed CORS origin(s), comma-separated. Set to the frontend URL(s) in
# production (e.g. https://app.evcore.io). No origin is allowed if omitted —
# same-origin/no-Origin requests (curl, server-to-server) still work.
CORS_ORIGINS=http://localhost:3000
AUTH_COOKIE_DOMAIN=c-evcore.com
# Public URL of the frontend — used for reset password links in emails.
APP_URL=http://localhost:3000

# ── Auth / MFA ─────────────────────────────────────────────────────────────────
# Random secret used to AES-256-GCM encrypt TOTP secrets stored in the database.
# Generate with: openssl rand -base64 32
# NEVER rotate this in production without decrypting and re-encrypting all TOTP secrets first.
TOTP_APP_SECRET=your_random_32_byte_secret_here

# ── Database ──────────────────────────────────
# Direct connection to PostgreSQL — used by Prisma migrations and Prisma Studio.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evcore
# PgBouncer pooled connection — used by the app at runtime (NestJS + ml-worker).
# In dev: postgresql://user:password@localhost:5433/evcore
# In prod: set automatically via docker-compose.prod.yml (pgbouncer:5432)
PGBOUNCER_URL=postgresql://postgres:postgres@localhost:5433/evcore

# ── Seed admin user (optional) ────────────────
# Used by `pnpm --filter @evcore/db db:seed`.
# The seed creates the admin only when SEED_ADMIN_PASSWORD is set.
SEED_ADMIN_EMAIL=admin@evcore.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_FULL_NAME=EVCore Admin
SEED_ADMIN_PASSWORD=

# ── Redis (BullMQ) ────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── API-FOOTBALL (api-football.com / v3.football.api-sports.io) ──
# Single key for fixtures, results, and pre-match odds.
# Plan Pro ($19/mo) recommended for MVP.
API_FOOTBALL_KEY=your_api_football_key_here
API_FOOTBALL_QUOTA_ALERT_PCT=80
API_FOOTBALL_DAILY_QUOTA=7500
# Capacity assumptions for quota planning logs at bootstrap
API_FOOTBALL_AVG_DAILY_FIXTURES_PER_LEAGUE=10
API_FOOTBALL_AVG_DAILY_STATS_FIXTURES_PER_LEAGUE=4

# ── Resend (email) ────────────────────────────────────────────────────────────
# Emails are sent via Resend HTTP API (port 443 — no SMTP, no firewall issues).
# Get your API key at https://resend.com/api-keys
# In local dev: leave empty to disable email sending.
RESEND_API_KEY=

# Sender address — must be a verified domain in your Resend account.
RESEND_FROM=noreply@yourdomain.com
# Single recipient for all admin alerts (you / your team).
RESEND_ADMIN_TO=admin@example.com

# ── Web Push (support chat notifications) ─────────────────────────────────────
# Generate a fresh pair once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave empty to disable push sending (subscriptions still save, just never fire).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI required by the Web Push protocol (mailto: or https:).
VAPID_SUBJECT=mailto:admin@example.com

# ── The Odds API (historical odds import) ─────────────────────────────────────
# Required only for the odds-historical-import worker.
# Free tier: 500 req/month. Paid plans available at the-odds-api.com.
THE_ODDS_API_KEY=your_the_odds_api_key_here

# Shadow /predictions cross-check (API-Football second model, shadow-only).
# Set to false to disable the per-analysis /predictions fetch.
SHADOW_PREDICTIONS_ENABLED=true

# ── ETL scheduling ────────────────────────────────
# Set to "false" to disable BullMQ repeatable jobs (useful in dev/test)
ETL_SCHEDULING_ENABLED=true

# Cron overrides (UTC). Set custom values only if you want to override these defaults.
# Fixtures sync — 02:00 UTC daily
ETL_FIXTURES_SYNC_CRON=0 2 * * *
# Pending bets settlement — every 30 minutes
ETL_PENDING_BETS_SETTLEMENT_CRON=*/30 * * * *
# Stale scheduled sync — 07:15 UTC daily
ETL_STALE_SCHEDULED_SYNC_CRON=15 7 * * *
# Stats sync — 04:00 UTC daily
ETL_STATS_SYNC_CRON=0 4 * * *
# Injuries sync — 06:00 UTC daily
ETL_INJURIES_SYNC_CRON=0 6 * * *
# Odds CSV import — 05:00 UTC every Monday
ETL_ODDS_CSV_IMPORT_CRON=0 5 * * 1
# Elo sync — 03:00 UTC daily
ETL_ELO_SYNC_CRON=0 3 * * *
# Odds prematch sync — 06:00 + 18:00 UTC (2 snapshots/day over J+1..J+3 so
# the line-movement signal has points to compare; 18:00 stays ahead of the
# 20:00 betting-engine analysis)
ETL_ODDS_PREMATCH_SYNC_CRON=0 6,18 * * *
# Betting engine analysis — 20:00 UTC daily
ETL_BETTING_ENGINE_ANALYSIS_CRON=0 20 * * *
# Rolling horizon warm preview — 17:00 UTC daily (J+1..J+4, overwritten by 18:00/20:00 authoritative runs)
ETL_ROLLING_HORIZON_CRON=0 17 * * *
# Coach tenure sync — 01:00 UTC every Sunday (coach changes are rare; a full
# pass is ~1725 teams * 6s rate limit ≈ 2.9h)
ETL_COACH_SYNC_CRON=0 1 * * 0
# Season rollover refresh — 01:45 UTC daily, just before FIXTURES_SYNC
# (02:00). Re-derives each competition's current season and re-upserts the
# league-sync job schedulers with it — without this, a season rollover
# (e.g. Aug 1) stays stuck on the old year until the next process restart,
# since upsertJobScheduler only bakes `season` into a job's template once,
# at call time.
ETL_SEASON_ROLLOVER_SYNC_CRON=45 1 * * *
# Concurrency for the betting-engine-rebuild worker (historical ModelRun
# backfill on FINISHED fixtures) — keep well under the API-FOOTBALL rate limit.
ETL_REBUILD_CONCURRENCY=4

# Rolling horizon — set to true to enable the daily warm-run cron for J+1..J+4
ETL_ENABLE_ROLLING_HORIZON=false
# Number of consecutive days to analyze in the rolling horizon (default: 4)
ETL_ROLLING_HORIZON_DAYS=4

# How many days back to look for stale SCHEDULED fixtures and re-sync them
STALE_SCHEDULED_SYNC_LOOKBACK_DAYS=14

# Odds snapshot maintenance (fallback default if no manual override in ETL job body)
ODDS_SNAPSHOT_RETENTION_DAYS=30

# ── Feature flags ────────────────────────────────────────────────────────────
# ML shadow correction — activate after ≥50 shadow picks validated.
# Set to "true" and restart the backend to enable without a code change.
ML_CORRECTION_ENABLED=false

# AVOID + calibration-alert enforcement at staking time (drops flagged picks/
# fixtures from the real coupon pool). Kill-switch: set to "false" to disable.
COUPON_ENFORCE_AVOID=true

# Kill-switch for staking the DRAW/NUL channel in coupon composition.
COUPON_STAKE_DRAW=true

# Fractional Kelly staking (coupon-composer.service.ts, betting-engine.service.ts).
# Never before a Phase 2 config flag decision (see CLAUDE.md) — leave false.
KELLY_ENABLED=false

# ── ML worker (Python, XGBoost calibration) ───────────────────────────────────
# Base URL of the ml-worker service. Defaults to the docker-compose service
# name — override for local dev if running ml-worker outside Docker.
ML_WORKER_URL=http://ml-worker:8000

# ── EVA chat / Groq ──────────────────────────────────────────────────────────
# Required for EVA (/chat) LLM orchestration.
# Never commit a real key; provide it in your local/runtime environment.
GROQ_API_KEY=your_groq_api_key_here
# Main tool-calling model used by EVA. Defaults to Llama 4 Scout if omitted
# (higher free-tier TPM budget). Switch to openai/gpt-oss-120b once that
# tier is paid — no code change needed, just this value.
CHAT_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Reasoning depth for gpt-oss models only (low | medium | high). Ignored by
# any other model. Defaults to "high" if omitted.
CHAT_GROQ_REASONING_EFFORT=high

# ── Logging ───────────────────────────────────────
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Directory for log files (defaults to <cwd>/logs if omitted)
LOG_DIR=./logs
