# Backend environment (docs/audits/2026-10-29/ENV-PROD.md § 6): secrets and
# addresses only, checked at start by src/config/env.schema.ts. Hours,
# thresholds and flags live in src/config/; operator switches in the
# app_setting table (admin screen); third-party keys in Réglages ›
# Intégrations (docs/exploitation.md). An empty value counts as absent.

# --- Process -----------------------------------------------------------------
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
LOG_DIR=./logs

# --- Addresses ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evcore
PGBOUNCER_URL=postgresql://postgres:postgres@localhost:5433/evcore
DATABASE_POOL_MAX=
REDIS_HOST=localhost
REDIS_PORT=6379
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
AUTH_COOKIE_DOMAIN=

# --- Secrets -----------------------------------------------------------------
# Required in production.
TOTP_APP_SECRET=your_random_32_byte_secret_here
ADMIN_API_TOKEN=
# Encrypts the secrets of Réglages › Intégrations (AES-256-GCM), at least 32
# characters: `openssl rand -base64 48`. The same value goes to the
# vantage-worker. Without it, secrets cannot be saved there and the
# variables below keep serving; changing it makes the stored ones unreadable.
SETTINGS_ENCRYPTION_KEY=

# --- Third-party services: fallback for Réglages › Intégrations ---------------
# Set them in the admin (Réglages › Intégrations) rather than here: a value
# stored there serves over the one below, within a minute, no restart. A
# variable still serves while its field is empty, then can go.
API_FOOTBALL_KEY=your_api_football_key_here
THE_ODDS_API_KEY=
RESEND_API_KEY=
RESEND_FROM=noreply@yourdomain.com
RESEND_ADMIN_TO=admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_PUBLIC_ENDPOINT=
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=evcore-support
RUSTFS_ACCESS_KEY=evcore_dev_access
RUSTFS_SECRET_KEY=evcore_dev_secret_change_me

# --- This machine ------------------------------------------------------------
# false on a local copy of production: no scheduled pass calls API-Football.
ETL_SCHEDULING_ENABLED=true

# The first admin account is not configured here: `pnpm --filter @evcore/db
# create-admin` asks for it at the terminal (docs/exploitation.md).
