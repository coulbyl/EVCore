{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": ["node", "vitest/globals"],
    "sourceMap": true,
    "outDir": "./dist",
    "ignoreDeprecations": "6.0",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@config/*": ["src/config/*"],
      "@modules/*": ["src/modules/*"],
      "@utils/*": ["src/utils/*"],
      "@common/*": ["src/common/*"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "test/**/*.ts",
    // Seulement ce script : les autres fichiers de scripts/ utilisent
    // `import.meta`, incompatible avec la sortie CommonJS de ce tsconfig, et
    // n'ont jamais été typecheckés. Les corriger sort du périmètre ; ne pas
    // élargir ce glob sans les traiter d'abord.
    "scripts/generate-v2-example.ts"
  ],
  "exclude": ["node_modules", "dist", "vitest.config.ts"]
}
