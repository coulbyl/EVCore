# Postgres — same database as the rest of EVCore (read via @evcore/db).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evcore

# Redis — same BullMQ broker used by ml-worker and the backend's ETL jobs.
REDIS_HOST=localhost
REDIS_PORT=6379

# Which provider serves the VANTAGE verdict call. All four speak the same
# OpenAI-compatible chat-completions API, so switching is just this line +
# that provider's API key below — no code change. Defaults to "groq".
#
# Recommended fallback when Groq's shared on-demand TPM limit (8000) or its
# Developer-tier upgrade being unavailable is blocking jobs: cerebras — it
# serves this exact model (gpt-oss-120b) with a real self-serve paid tier.
# NOTE: situational research (VANTAGE_ENABLE_RESEARCH, below) has its own
# separate provider switch (VANTAGE_RESEARCH_PROVIDER) — it does NOT have to
# use this LLM_PROVIDER. The default research provider ("groq") needs a
# Groq client configured SOMEWHERE (this LLM_PROVIDER, or "groq" listed in
# LLM_PROVIDER_FALLBACKS below), not necessarily as the primary.
LLM_PROVIDER=groq

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Cerebras — https://cloud.cerebras.ai/platform/keys (LLM_PROVIDER=cerebras)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# Together AI — https://api.together.ai/settings/api-keys (LLM_PROVIDER=together)
TOGETHER_API_KEY=
TOGETHER_MODEL=openai/gpt-oss-120b

# Fireworks AI — https://fireworks.ai/account/api-keys (LLM_PROVIDER=fireworks)
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/gpt-oss-120b

# Comma-separated automatic fallback chain, tried in order — only on a
# TRANSIENT failure from the current provider (429 rate limit, 5xx,
# connection/timeout), never on a config error (bad key, bad request), and
# never a substitute for fixing a persistently broken primary. Each name
# listed here needs its own *_API_KEY above filled in — a fallback whose key
# is missing fails the worker at startup rather than silently doing nothing
# during the exact outage it exists for. Empty by default (no fallback).
# Example: LLM_PROVIDER=groq with LLM_PROVIDER_FALLBACKS=cerebras,together
# keeps Groq as the default and hops to Cerebras, then Together, on a 429.
LLM_PROVIDER_FALLBACKS=

# How often (ms) the worker sweeps for fixtures ready for a VANTAGE read.
SWEEP_INTERVAL_MS=300000

# Comma-separated competition codes to restrict VANTAGE's VERDICT to. Leave
# EMPTY — the agreed rollout runs on all active competitions from day one,
# since the verdict-only pipeline costs ~$1/month even at full volume (see
# docs/architecture.md — Cost). This is NOT the same list as
# VANTAGE_RESEARCH_COMPETITION_CODES below.
VANTAGE_COMPETITION_CODES=

# Web search ("l'ouverture à internet") — OFF by default. Adds one search
# call per fixture for live team news/injuries before the verdict call.
# Billed per-request on top of tokens and does NOT stay negligible at full
# 68-league volume — see docs/architecture.md — Situational research (cost).
VANTAGE_ENABLE_RESEARCH=false

# Which backend serves the search call above — "groq" (default, native
# groq/compound-mini agentic web search — needs a Groq client configured
# somewhere, see the LLM_PROVIDER note above; $5-8 per 1000 requests) or
# "tavily" (a direct call to Tavily's own /search API, independent of any
# LLM provider — reach for this when Groq's Developer tier is closed for
# new signups or its shared 8000 TPM tier makes compound-mini unreliable;
# Tavily's free tier is 1000 credits/month, no card required, which
# comfortably covers VANTAGE's default "grands championnats" volume for $0).
VANTAGE_RESEARCH_PROVIDER=groq
GROQ_RESEARCH_MODEL=groq/compound-mini

# Required only when VANTAGE_RESEARCH_PROVIDER=tavily — get one at
# https://app.tavily.com (free tier, no credit card).
TAVILY_API_KEY=

# Which leagues get the (costed) research call when VANTAGE_ENABLE_RESEARCH
# is on — VANTAGE still writes a verdict everywhere either way (see
# VANTAGE_COMPETITION_CODES above), research just doesn't run everywhere.
# Leave commented out/unset to use the built-in default ("les grands
# championnats" — Premier League, La Liga, Bundesliga, Serie A, Ligue 1,
# Champions League, Europa League, Europa Conference League:
# PL,LL,BL1,SA,L1,UCL,UEL,UECL). Set it to a comma-separated list to override
# that default — e.g. to add a league or narrow it further. There is no way
# to set "zero leagues" here other than VANTAGE_ENABLE_RESEARCH=false —
# unlike VANTAGE_COMPETITION_CODES, an unset/empty value here never means
# "every league", it means "the curated default".
# VANTAGE_RESEARCH_COMPETITION_CODES=PL,LL,BL1,SA,L1,UCL,UEL,UECL

LOG_LEVEL=info
