# vantage-worker environment (docs/audits/2026-10-29/ENV-PROD.md § 6):
# addresses, the provider chain and its keys, research. Models, hours and
# the sweep interval are decisions in src/config.ts; the coupon hour is
# COUPON_SCHEDULE in packages/analysis-core. An empty value counts as
# absent; retired variables are named in the start-up log.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evcore
REDIS_HOST=localhost
REDIS_PORT=6379
LOG_LEVEL=info

# Primary provider (groq | cerebras | together | fireworks) and the ordered
# fallbacks tried on a 429, a 5xx or a timeout. Each one needs its key.
LLM_PROVIDER=groq
LLM_PROVIDER_FALLBACKS=
GROQ_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=

# Web research before the verdict (billed per request): off unless "true".
VANTAGE_ENABLE_RESEARCH=false
VANTAGE_RESEARCH_PROVIDER=groq
TAVILY_API_KEY=
