{
  // Turbo ≥ 2.11 réécrit un bloc de consignes dans AGENTS.md quand il détecte
  // un agent ; AGENTS.md est tenu à la main ici, on désactive.
  "agentGuidance": false,
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "API_FOOTBALL_KEY",
    "DATABASE_URL",
    "PGBOUNCER_URL",
    "DATABASE_POOL_MAX",
    "SEED_ADMIN_EMAIL",
    "SEED_ADMIN_USERNAME",
    "SEED_ADMIN_FULL_NAME",
    "SEED_ADMIN_PASSWORD",
    "REDIS_HOST",
    "REDIS_PORT",
    "LLM_PROVIDER",
    "LLM_PROVIDER_FALLBACKS",
    "GROQ_API_KEY",
    "GROQ_MODEL",
    "CEREBRAS_API_KEY",
    "CEREBRAS_MODEL",
    "TOGETHER_API_KEY",
    "TOGETHER_MODEL",
    "FIREWORKS_API_KEY",
    "FIREWORKS_MODEL",
    "LOG_LEVEL",
    "SWEEP_INTERVAL_MS",
    "VANTAGE_COMPETITION_CODES",
    "VANTAGE_ENABLE_RESEARCH",
    "VANTAGE_RESEARCH_PROVIDER",
    "GROQ_RESEARCH_MODEL",
    "TAVILY_API_KEY",
    "VANTAGE_RESEARCH_COMPETITION_CODES",
    "VANTAGE_COUPON_CRON",
    "VANTAGE_COUPON_RETRY_CRON",
    "VANTAGE_COUPON_INTRADAY_CRON",
    "VANTAGE_COUPON_INTRADAY_WINDOW_HOURS",
    "SAME_DAY_ANALYSIS_WINDOW_HOURS",
    "ETL_SAME_DAY_ANALYSIS_CRON"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "backend#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "@evcore/db#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["src/generated/prisma/**", "dist/**"]
    },
    "@evcore/transactional#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },
    "@evcore/analysis-core#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },
    "@evcore/backtest-core#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build", "^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      // A phone on the local network opening the dev server (next.config.js).
      "passThroughEnv": ["NEXT_DEV_ORIGINS"]
    },
    // Lighthouse sur un build déjà fait contre le faux backend
    // (apps/web/scripts/lighthouse-budgets.mjs) : une mesure, jamais en cache.
    "budgets": {
      "cache": false,
      "env": [
        "BUDGET_WEB_PORT",
        "BUDGET_MOCK_PORT",
        "BUDGET_RUNS",
        "LCP_EXPLAIN",
        "CHROME_PATH",
        "GITHUB_STEP_SUMMARY"
      ]
    }
  }
}
