{
  "name": "@evcore/backtest-core",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "backtest:deterministic-coupon": "tsx scripts/backtest-deterministic-coupon.ts",
    "backtest:league-coupon": "tsx scripts/backtest-league-coupon.ts",
    "report:league": "tsx scripts/league-report.ts",
    "backtest:coverage-check": "tsx scripts/coverage-check.ts",
    "backtest:daily-coupon": "tsx scripts/backtest-daily-coupon.ts",
    "backtest:generator": "tsx scripts/backtest-generator.ts",
    "probe:api-football": "tsx --env-file=../../apps/backend/.env scripts/probe-api-football.ts",
    "probe:margins": "tsx --env-file=../../apps/backend/.env scripts/probe-market-margins.ts",
    "report:freshness": "tsx scripts/report-odds-freshness.ts",
    "report:coupon-clv": "tsx scripts/report-coupon-clv.ts",
    "report:selection-clv": "tsx scripts/report-selection-clv.ts",
    "report:coupon-policies": "tsx scripts/report-coupon-policies.ts",
    "report:margin-paid": "tsx scripts/report-margin-paid.ts",
    "report:new-markets": "tsx scripts/report-new-markets.ts",
    "collect:asian-handicap": "tsx --env-file=../../apps/backend/.env scripts/collect-asian-handicap-history.ts",
    "backtest:asian-handicap": "tsx scripts/backtest-asian-handicap.ts",
    "backtest:composer": "tsx scripts/backtest-composer.ts",
    "backtest:strategy-ranking": "tsx scripts/backtest-strategy-ranking.ts",
    "backtest:team-total-band-shrinkage": "tsx scripts/backtest-team-total-band-shrinkage.ts",
    "backtest:engine-combo-margin": "tsx scripts/backtest-engine-combo-margin.ts",
    "backtest:congestion-centering": "tsx scripts/backtest-congestion-centering.ts",
    "backtest:league-strength": "tsx scripts/backtest-league-strength.ts",
    "backtest:market-grid": "tsx scripts/backtest-market-grid.ts",
    "backtest:goal-dependence": "tsx scripts/backtest-goal-dependence.ts",
    "backtest:half-time": "tsx scripts/backtest-half-time.ts",
    "backtest:corners-cards": "tsx scripts/backtest-corners-cards.ts",
    "probe:extras": "tsx --env-file=../../apps/backend/.env scripts/probe-api-football.ts --extras",
    "probe:inventory": "tsx --env-file-if-exists=../../apps/backend/.env scripts/probe-api-football.ts --inventory"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "@evcore/analysis-core": "workspace:*",
    "@evcore/db": "workspace:*",
    "decimal.js": "catalog:"
  },
  "devDependencies": {
    "@evcore/eslint-config": "workspace:*",
    "@evcore/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
