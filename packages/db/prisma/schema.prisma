model UserBadge {
  id         String   @id @default(cuid())
  userId     String   @db.Uuid
  badgeCode  String
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge      Badge    @relation(fields: [badgeCode], references: [code])

