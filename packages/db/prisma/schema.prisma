// ─────────────────────────────────────────────
// AI ENGINE — Coupon proposals
// ─────────────────────────────────────────────

model CouponProposal {
  id                     String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  forDate                DateTime             @db.Date
  signalWindowDays       Int
  targetOddsMin          Decimal              @db.Decimal(6, 2)
  targetOddsMax          Decimal              @db.Decimal(6, 2)
  combinedOdds           Decimal              @db.Decimal(8, 3)
  // Cote réellement payée au settlement, calculée sur les seules jambes NON
  // voidées. `null` tant que non réglé ; égale à `combinedOdds` sur un WON sans
  // void. Distincte de `combinedOdds` (cote proposée à l'origine, affichée
  // ailleurs) pour ne jamais perdre la valeur initialement annoncée. Voir
  // TODO.md "Agrégats ROI/summary ignorent silencieusement PARTIAL/VOID".
  realizedOdds           Decimal?             @db.Decimal(8, 3)
  jointProbability       Decimal              @db.Decimal(5, 4)
  signalScore            Decimal              @db.Decimal(5, 4)
  status                 CouponProposalStatus @default(PENDING)
  result                 CouponResult?
  reasoning              Json?
  rank                   Int                  @default(1) // 1 = meilleur coupon du jour, 2 = second, etc.
  lastFixtureScheduledAt DateTime
  legs                   CouponProposalLeg[]
  subscriptionEvents     SubscriptionEvent[]
  generatedAt            DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@unique([forDate, signalWindowDays, targetOddsMin, targetOddsMax, rank])
  @@index([forDate, status])
  @@index([status, lastFixtureScheduledAt])
  @@map("coupon_proposal")
  @@schema("public")
}

model CouponProposalLeg {
  id               String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  couponProposalId String          @db.Uuid
  couponProposal   CouponProposal  @relation(fields: [couponProposalId], references: [id], onDelete: Cascade)
  fixtureId        String          @db.Uuid
  fixture          Fixture         @relation(fields: [fixtureId], references: [id])
  canal            StrategyChannel
  market           Market
  pick             String
  probability      Decimal         @db.Decimal(5, 4)
  oddsSnapshot     Decimal?        @db.Decimal(6, 3)
  signalScore      Decimal         @db.Decimal(5, 4)
  featureSnapshot  Json
  isCorrect        Boolean?
  settledAt        DateTime?
  createdAt        DateTime        @default(now())

  @@index([couponProposalId])
  @@index([fixtureId])
  @@map("coupon_proposal_leg")
  @@schema("public")
}

// ─────────────────────────────────────────────
// Subscriptions — mise virtuelle automatique, suivi de discipline
// (apps/backend/src/modules/subscriptions/DESIGN.md)
// ─────────────────────────────────────────────

model Subscription {
  id              String                       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String                       @db.Uuid
  user            User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType      SubscriptionSourceType
  // Instantané du libellé au moment de la création. TRACE D'AUDIT UNIQUEMENT :
  // ne jamais s'en servir pour afficher quoi que ce soit — utiliser
  // subscriptionSourceLabel(sourceType), qui rend le libellé courant.
  //
  // Le figeage était volontaire (préserver ce que l'utilisateur avait vu) et
  // s'est retourné contre nous le 2026-08-22 : deux libellés du catalogue
  // étaient factuellement faux, et les figer revenait à continuer de les
  // affirmer indéfiniment dans les notifications des abonnés existants. Un
  // instantané peut préserver une formulation, pas perpétuer une erreur.
  sourceLabel     String
  // Obligatoire si sourceType est un CHANNEL_*, doit être null pour
  // COUPON_BEST/COUPON_ALL (validé côté API, pas de contrainte DB — Prisma ne
  // fait pas de check conditionnel inter-colonnes).
  channelPickMode SubscriptionChannelPickMode?
  // Idem : obligatoire si sourceType est un CHANNEL_* (valeur du catalogue
  // SUBSCRIPTION_TOPN_OPTIONS, 1/3/5), null pour COUPON_BEST (toujours 1 par
  // définition) et COUPON_ALL (toujours "tous", pas de notion de topN).
  topN            Int?
  stakePerEvent   Decimal                      @db.Decimal(14, 2)
  // Jours de semaine éligibles, 0=dimanche..6=samedi ; vide si seule la
  // condition ligue est utilisée.
  daysOfWeek      Int[]
  // Codes de compétition choisis librement par l'utilisateur (ex. ['PL','BL1']),
  // validés à la création contre Competition.code (Competition.isActive = true) —
  // vide si aucune condition de championnat n'est utilisée. Combiné à daysOfWeek
  // par OR. Pas de FK Prisma directe vers Competition (tableau de codes, pas de
  // relation many-to-many) — même choix que les codes en dur dans
  // BTTS_STAKED_LEAGUES/LAMBDA_SCALE_MAP ailleurs dans le code.
  competitionCodes String[]
  startDate       DateTime                     @db.Date
  endDate         DateTime                     @db.Date
  status          SubscriptionStatus           @default(ACTIVE)
  cancelledAt     DateTime?
  // Compteurs incrémentés à chaque règlement d'un SubscriptionEvent — évite de
  // resommer l'historique complet à chaque affichage.
  totalEvents     Int                          @default(0)
  settledEvents   Int                          @default(0)
  wonEvents       Int                          @default(0)
  totalStaked     Decimal                      @default(0) @db.Decimal(14, 2)
  netPnl          Decimal                      @default(0) @db.Decimal(14, 2)
  events          SubscriptionEvent[]
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@index([userId, status])
  @@index([status, endDate])
  @@map("subscription")
  @@schema("public")
}

// Un événement par occurrence de la source, un jour où la condition de
// l'abonnement était remplie. Pour COUPON_BEST/CHANNEL_* à topN=1, exactement
// un événement par jour. Pour COUPON_ALL et CHANNEL_* à topN>1, jusqu'à
// plusieurs événements le même jour (un par coupon/pick trouvé). PENDING
// (result = null) tant que le résultat réel n'est pas connu.
model SubscriptionEvent {
  id                 String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subscriptionId     String            @db.Uuid
  subscription       Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  date               DateTime          @db.Date
  // Exactement un des deux est renseigné, selon subscription.sourceType.
  couponProposalId   String?           @db.Uuid
  couponProposal     CouponProposal?   @relation(fields: [couponProposalId], references: [id])
  channelSelectionId String?           @db.Uuid
  channelSelection   ChannelSelection? @relation(fields: [channelSelectionId], references: [id])
  // Copié depuis Subscription.stakePerEvent à la création — l'historique déjà
  // simulé ne doit jamais être réécrit rétroactivement.
  stake              Decimal           @db.Decimal(14, 2)
  odds               Decimal?          @db.Decimal(6, 3)
  result             BetStatus? // null = en attente
  pnl                Decimal?          @db.Decimal(14, 2)
  settledAt          DateTime?
  createdAt          DateTime          @default(now())

  // Pas juste (subscriptionId, date) : COUPON_ALL (plusieurs coupons/jour) et
  // CHANNEL_* avec topN > 1 (plusieurs picks/jour) produisent chacun plusieurs
  // événements le même jour, différenciés par couponProposalId/channelSelectionId
  // respectivement. Pour COUPON_BEST et CHANNEL_* à topN=1, cette contrainte se
  // comporte comme (subscriptionId, date) — même garantie d'idempotence, juste
  // exprimée plus largement pour couvrir tous les cas.
  @@unique([subscriptionId, date, couponProposalId, channelSelectionId])
  @@index([subscriptionId])
  @@index([result, date])
  @@map("subscription_event")
  @@schema("public")
}

// ─────────────────────────────────────────────
// ML — Phase 3
// ─────────────────────────────────────────────

model MlModelVersion {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  createdAt    DateTime         @default(now())
  // Target segment: "EV:ONE_X_TWO" | "CONF:ONE_X_TWO" | "ALL" etc.
  segment      String
  // "logistic_regression" | "xgboost"
  algorithm    String
  // Feature names used during training
  features     Json
  // { brierScore, calibrationError, roiShadow, sampleSize, trainSize, testSize }
  metrics      Json
  // Path to serialized model on shared Docker volume (ml-models/)
  modelPath    String?
  isActive     Boolean          @default(false)
  activatedAt  DateTime?
  notes        String?
  rollbackOfId String?          @db.Uuid
  rollbackOf   MlModelVersion?  @relation("MlRollback", fields: [rollbackOfId], references: [id])
  rollbacks    MlModelVersion[] @relation("MlRollback")

  @@index([isActive, segment])
  @@index([segment, createdAt])
  @@map("ml_model_version")
  @@schema("public")
}

// ─────────────────────────────────────────────
// EVA — AI chat analyst (Phase 4)
// ─────────────────────────────────────────────

model ChatConversation {
  id        String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String        @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Auto-generated from the first question (truncated).
  title     String?
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, updatedAt])
  @@map("chat_conversation")
  @@schema("public")
}

model ChatMessage {
  id             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  conversationId String           @db.Uuid
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // 'user' | 'assistant' | 'tool'
  role           String
  content        String
  // Set when role = 'tool'.
  toolName       String?
  // Validated tool-call arguments (audit + replay).
  toolArgs       Json?
  // Structured engine picks shown as cards (role = 'assistant' only).
  picks          Json?
  inputTokens    Int              @default(0)
  outputTokens   Int              @default(0)
  // LLM used (e.g. "llama-4-scout" / "llama-3.1-8b-instant").
  model          String?
  // Prompt system version, for correlating quality regressions.
  promptVersion  String?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@map("chat_message")
  @@schema("public")
}

// ─────────────────────────────────────────────
// Support chat — human 1:1 conversation with the EVCore team
// (feedback + personal questions + Business-tier interest), distinct from
// the Eva LLM chat above: no tool calls, no token accounting, just messages.
// ─────────────────────────────────────────────

enum SupportConversationStatus {
  OPEN
  CLOSED

  @@schema("public")
}

model SupportConversation {
  id            String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String                    @db.Uuid
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        SupportConversationStatus @default(OPEN)
  // Read watermarks — one conversation, two sides, each tracks its own "read up to".
  userReadAt    DateTime?
  adminReadAt   DateTime?
  messages      SupportMessage[]
  lastMessageAt DateTime                  @default(now())
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([status, lastMessageAt])
  @@index([userId])
  @@map("support_conversation")
  @@schema("public")
}

model SupportMessage {
  id             String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  conversationId String              @db.Uuid
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String              @db.Uuid
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
  @@map("support_message")
  @@schema("public")
}

// One row per subscribed browser/device (Push API), not per user — the same
// account can have several active subscriptions (phone + desktop). Endpoint
// is the dedup key: re-subscribing the same device updates in place.
model PushSubscription {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscription")
  @@schema("public")
}

// Per-user daily usage — rate limiting + cost tracking.
model ChatUsage {
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day          DateTime @db.Date
  requests     Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)

  @@id([userId, day])
  @@map("chat_usage")
  @@schema("public")
}

