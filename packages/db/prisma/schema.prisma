// EVCore — Prisma Schema
// See EVCORE.md section 3.4 for table descriptions
// See CLAUDE.md for repository conventions

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  moduleFormat  = "cjs"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "calibration"]
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum FixtureStatus {
  SCHEDULED
  IN_PROGRESS
  FINISHED
  POSTPONED
  CANCELLED

  @@schema("public")
}

enum ModelRunPhase {
  ADVANCE
  PRE_KICKOFF
  LIVE

  @@schema("public")
}

enum Market {
  ONE_X_TWO
  OVER_UNDER
  BTTS
  DOUBLE_CHANCE
  HALF_TIME_FULL_TIME
  OVER_UNDER_HT
  FIRST_HALF_WINNER
  CORRECT_SCORE
  DRAW_NO_BET
  TEAM_TOTAL_HOME
  TEAM_TOTAL_AWAY
  CLEAN_SHEET_HOME
  CLEAN_SHEET_AWAY
  WIN_TO_NIL_HOME
  WIN_TO_NIL_AWAY
  TO_WIN_EITHER_HALF
  RESULT_TOTAL_GOALS
  RESULT_BTTS

  @@schema("public")
}

enum BetStatus {
  PENDING
  WON
  LOST
  VOID

  @@schema("public")
}

enum BetSource {
  MODEL
  USER

  @@schema("public")
}

enum BetSlipType {
  SIMPLE
  COMBO

  @@schema("public")
}

enum BankrollTransactionType {
  DEPOSIT
  BET_PLACED
  BET_WON
  BET_VOID

  @@schema("public")
}

enum UserRole {
  ADMIN
  OPERATOR

  @@schema("public")
}

enum UnitMode {
  FIXED
  PCT

  @@schema("public")
}

enum FormationContentType {
  ARTICLE
  VIDEO

  @@schema("public")
}

enum AdjustmentStatus {
  PENDING
  APPLIED
  REJECTED
  FROZEN

  @@schema("public")
}

enum OddsSnapshotSource {
  PREMATCH
  HISTORICAL

  @@schema("public")
}

enum NotificationType {
  ROI_ALERT
  MARKET_SUSPENSION
  BRIER_ALERT
  WEEKLY_REPORT
  ETL_FAILURE
  WEIGHT_ADJUSTMENT
  XG_UNAVAILABLE_REPORT
  ML_MODEL_ACTIVATED
  ML_MODEL_MISSING
  // Personnelles (Notification.userId non-null) — voir commentaire sur le
  // modèle Notification.
  SUBSCRIPTION_EVENTS_ADDED
  SUBSCRIPTION_SETTLED
  SUPPORT_MESSAGE
  // Broadcast (Notification.userId null) — voir OPERATOR_TYPES dans
  // notification.service.ts.
  ANNOUNCEMENT_PUBLISHED

  @@schema("public")
}

enum MfaMethod {
  EMAIL
  TOTP

  @@schema("public")
}

enum SportType {
  FOOTBALL

  @@schema("public")
}

enum StrategyChannel {
  VALUE
  SAFE
  DOMINANT
  BTTS
  DRAW
  GOALS
  CLEAN_SHEET
  TEAM_TOTAL
  WIN_EITHER_HALF
  FIRST_HALF
  DOUBLE_CHANCE
  UNDERDOG
  FAVORITE
  LIVE_VALUE
  MARKET_MOVE
  CONSENSUS
  CONTRARIAN
  AVOID
  CORRECT_SCORE
  RESULT_TOTAL_GOALS
  OVER_UNDER_HT
  RESULT_BTTS
  DRAW_NO_BET
  WIN_TO_NIL
  HALF_TIME_FULL_TIME
  VANTAGE

  @@schema("public")
}

enum ChannelDecisionStatus {
  SELECTED
  REJECTED
  DISABLED
  INSUFFICIENT_DATA
  MISSING_ODDS
  NOT_APPLICABLE

  @@schema("public")
}

enum CouponProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED

  @@map("coupon_proposal_status")
  @@schema("public")
}

enum CouponResult {
  WON
  LOST
  PARTIAL
  VOID

  @@map("coupon_result")
  @@schema("public")
}

// Subscriptions (apps/backend/src/modules/subscriptions/DESIGN.md) — mise
// virtuelle automatique, indépendante du portefeuille réel.
enum SubscriptionSourceType {
  COUPON_BEST // CouponProposal, rank = 1 uniquement
  COUPON_ALL // Chaque CouponProposal généré ce jour-là (rank 1..maxCoupons), mise pleine sur chacun
  CHANNEL_VALUE
  CHANNEL_SAFE
  CHANNEL_DOMINANT
  CHANNEL_DRAW
  CHANNEL_BTTS
  CHANNEL_DOUBLE_CHANCE
  CHANNEL_TEAM_TOTAL

  @@map("subscription_source_type")
  @@schema("public")
}

enum SubscriptionStatus {
  ACTIVE
  ENDED // endDate dépassée, terminé naturellement
  CANCELLED // arrêté par l'utilisateur avant endDate

  @@map("subscription_status")
  @@schema("public")
}

// Uniquement pertinent quand sourceType est un CHANNEL_* (ignoré/null pour
// COUPON_BEST/COUPON_ALL, validé côté API — voir DESIGN.md).
enum SubscriptionChannelPickMode {
  INVESTIR // pick(s) classé(s) par probabilité calibrée, comme la page Investir
  // Les deux variantes DECISIONS_* restent volontairement sans classement
  // (pas de proba/edge/calibration) — seul l'axe chronologique change. Un
  // backtest day-by-day (db:backtest:decisions-ranking, 2026-07-29) montre
  // que "derniers du jour" bat ou égale "premiers du jour" sur les canaux
  // testés, sans qu'aucune des deux ne domine partout — laissé au choix de
  // l'utilisateur plutôt que tranché unilatéralement. ⚠️ Les chiffres de ce
  // backtest portaient sur des topN par canal supprimés depuis (audit
  // 2026-08-22) ; seule la comparaison premiers/derniers reste valable.
  DECISIONS_FIRST // match(s) le(s) plus tôt du jour par heure de coup d'envoi
  DECISIONS_LAST // match(s) le(s) plus tard du jour par heure de coup d'envoi

  @@map("subscription_channel_pick_mode")
  @@schema("public")
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model Competition {
  id                String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  leagueId          Int        @unique
  code              String     @unique
  name              String
  country           String
  sport             SportType  @default(FOOTBALL)
  isActive          Boolean
  includeInBacktest Boolean    @default(true)
  csvDivisionCode   String?
  seasonStartMonth  Int?
  apiSeasonOverride Int?
  seasons           Season[]
  teams             Team[]
  standings         Standing[]
  createdAt         DateTime   @default(now())

  @@map("competition")
  @@schema("public")
}

model Season {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  competitionId String      @db.Uuid
  competition   Competition @relation(fields: [competitionId], references: [id])
  name          String // e.g. "2022-23"
  startDate     DateTime
  endDate       DateTime
  fixtures      Fixture[]
  standings     Standing[]
  createdAt     DateTime    @default(now())

  @@unique([competitionId, name])
  @@map("season")
  @@schema("public")
}

model Standing {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  competitionId String      @db.Uuid
  seasonId      String      @db.Uuid
  competition   Competition @relation(fields: [competitionId], references: [id])
  season        Season      @relation(fields: [seasonId], references: [id])
  teamApiId     Int
  teamName      String
  teamLogo      String
  group         String
  rank          Int
  points        Int
  played        Int
  win           Int
  draw          Int
  lose          Int
  goalsFor      Int
  goalsAgainst  Int
  goalsDiff     Int
  form          String?
  description   String?
  syncedAt      DateTime    @updatedAt

  @@unique([competitionId, seasonId, teamApiId])
  @@map("standing")
  @@schema("public")
}

model Team {
  id            String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  externalId    Int           @unique // football-data.org ID
  name          String
  shortName     String
  logoUrl       String?
  competitionId String        @db.Uuid
  competition   Competition   @relation(fields: [competitionId], references: [id])
  homeFixtures  Fixture[]     @relation("HomeTeam")
  awayFixtures  Fixture[]     @relation("AwayTeam")
  stats         TeamStats[]
  coachTenures  CoachTenure[]
  createdAt     DateTime      @default(now())

  @@map("team")
  @@schema("public")
}

// Managerial spell history per team — feeds the `sameCoach` H2H discount
// proxy (docs/h2h-service-v2-plan.md §3.4, v2.3a): "does this past H2H leg
// still reflect the same tactical philosophy". One row per tenure;
// endDate null = still in charge as of last sync (coachs-sync.worker.ts,
// API-Football GET /coachs?team={id}).
model CoachTenure {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  teamId    String    @db.Uuid
  team      Team      @relation(fields: [teamId], references: [id])
  coachName String
  startDate DateTime
  endDate   DateTime?
  syncedAt  DateTime  @default(now())

  @@unique([teamId, coachName, startDate])
  @@index([teamId, startDate])
  @@map("coach_tenure")
  @@schema("public")
}

model Fixture {
  id                 String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  externalId         Int                 @unique // football-data.org ID
  seasonId           String              @db.Uuid
  season             Season              @relation(fields: [seasonId], references: [id])
  homeTeamId         String              @db.Uuid
  homeTeam           Team                @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId         String              @db.Uuid
  awayTeam           Team                @relation("AwayTeam", fields: [awayTeamId], references: [id])
  matchday           Int
  round              String? // raw API round string (e.g. "Quarter-finals", "League Stage - 1")
  leg                Int? // 1 = aller, 2 = retour — null for group/league stage
  aggregateHomeGoals Int? // goals scored by home team's side in leg 1 (set on leg 2 only)
  aggregateAwayGoals Int? // goals scored by away team's side in leg 1 (set on leg 2 only)
  scheduledAt        DateTime
  status             FixtureStatus       @default(SCHEDULED)
  homeScore          Int?
  awayScore          Int?
  homeHtScore        Int?
  awayHtScore        Int?
  homeXg             Decimal?            @db.Decimal(5, 3) // from API-Football expected_goals
  awayXg             Decimal?            @db.Decimal(5, 3) // from API-Football expected_goals
  xgUnavailable      Boolean             @default(false) // true = API returned no stats, skip on retry
  modelRuns          ModelRun[]
  bets               Bet[]
  betSlipItems       BetSlipItem[]
  teamStats          TeamStats[]
  oddsSnapshots      OddsSnapshot[]
  couponLegs         CouponProposalLeg[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([seasonId, matchday])
  @@index([seasonId, round])
  @@index([scheduledAt])
  @@index([status, scheduledAt])
  @@index([seasonId, status, scheduledAt])
  @@index([homeTeamId, status, scheduledAt])
  @@index([awayTeamId, status, scheduledAt])
  @@map("fixture")
  @@schema("public")
}

// Rolling stats computed for a team after a given fixture was played.
// One row per team per fixture (home team stats + away team stats).
model TeamStats {
  id             String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  teamId         String  @db.Uuid
  team           Team    @relation(fields: [teamId], references: [id])
  afterFixtureId String  @db.Uuid
  afterFixture   Fixture @relation(fields: [afterFixtureId], references: [id])

  // Feature values used in the deterministic scoring model (see EVCORE.md §4.1)
  recentForm       Decimal @db.Decimal(5, 4) // weighted 5-match form (decay 0.8)
  xgFor            Decimal @db.Decimal(5, 3) // rolling xG scored (10 matches)
  xgAgainst        Decimal @db.Decimal(5, 3) // rolling xG conceded (10 matches)
  homeWinRate      Decimal @db.Decimal(5, 4) // season home win rate
  awayWinRate      Decimal @db.Decimal(5, 4) // season away win rate
  drawRate         Decimal @db.Decimal(5, 4) // season draw rate
  leagueVolatility Decimal @db.Decimal(5, 4) // std-dev of total goals in league

  createdAt DateTime @default(now())

  @@unique([teamId, afterFixtureId])
  @@map("team_stats")
  @@schema("public")
}

// Output of one betting engine analysis for a fixture.
model ModelRun {
  id         String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fixtureId  String        @db.Uuid
  fixture    Fixture       @relation(fields: [fixtureId], references: [id])
  analyzedAt DateTime      @default(now())
  phase      ModelRunPhase @default(PRE_KICKOFF)

  deterministicScore Decimal  @db.Decimal(5, 4)
  llmDelta           Decimal? @db.Decimal(5, 4) // null in MVP (OpenClaw not active)
  finalScore         Decimal  @db.Decimal(5, 4)

  // Snapshot of feature values at analysis time — enables ModelRun replay
  features    Json // { recentForm, xg, performanceDomExt, volatiliteLigue }
  openclawRaw Json? // raw LLM output — null in MVP

  validatedByBackend Boolean           @default(false)
  bets               Bet[]
  channelDecisions   ChannelDecision[]
  createdAt          DateTime          @default(now())

  @@index([fixtureId])
  @@index([fixtureId, analyzedAt])
  @@index([analyzedAt])
  @@index([phase, analyzedAt])
  @@map("model_run")
  @@schema("public")
}

// One bet per market per ModelRun.
model Bet {
  id                   String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  modelRunId           String                @db.Uuid
  modelRun             ModelRun              @relation(fields: [modelRunId], references: [id])
  fixtureId            String                @db.Uuid
  fixture              Fixture               @relation(fields: [fixtureId], references: [id])
  market               Market
  pick                 String // HOME | DRAW | AWAY | OVER | UNDER | YES | NO | 1X | X2 | 12
  pickKey              String // canonical key: "<market>|<pick>"
  probEstimated        Decimal               @db.Decimal(5, 4)
  oddsSnapshot         Decimal?              @db.Decimal(6, 3) // null in MVP phase 1 (no prematch odds)
  ev                   Decimal               @db.Decimal(6, 4) // EV = (probEstimated * oddsSnapshot) - 1
  qualityScore         Decimal?              @db.Decimal(6, 4) // ev × deterministicScore — used for pick pool ranking (null for legacy bets)
  stakePct             Decimal               @db.Decimal(5, 4) // 0.01 = 1% bankroll
  status               BetStatus             @default(PENDING)
  // source: MODEL for engine bets, USER for user-placed picks from evaluated picks
  source               BetSource             @default(MODEL)
  userId               String?               @db.Uuid
  user                 User?                 @relation(fields: [userId], references: [id])
  // link to the ChannelSelection that generated this bet (null for legacy bets)
  channelSelectionId   String?               @db.Uuid
  channelSelection     ChannelSelection?     @relation(fields: [channelSelectionId], references: [id])
  betSlipItems         BetSlipItem[]
  bankrollTransactions BankrollTransaction[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([fixtureId, pickKey, userId])
  @@index([modelRunId])
  @@index([fixtureId])
  @@index([market, status, createdAt])
  @@index([status, updatedAt])
  @@index([userId])
  @@map("bet")
  @@schema("public")
}

model User {
  id                               String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email                            String                  @unique
  username                         String                  @unique
  passwordHash                     String
  fullName                         String
  bio                              String?
  role                             UserRole                @default(OPERATOR)
  emailVerified                    Boolean                 @default(false)
  mfaMethod                        MfaMethod?
  totpSecret                       String?
  totpVerified                     Boolean                 @default(false)
  avatarUrl                        String?
  theme                            String?
  locale                           String?
  currency                         String?
  unitMode                         UnitMode?
  unitAmount                       Decimal?                @db.Decimal(12, 2)
  unitPercent                      Decimal?                @db.Decimal(5, 4)
  emailSupportNotificationsEnabled Boolean                 @default(true)
  hasSeenOnboarding                Boolean                 @default(false)
  suspended                        Boolean                 @default(false)
  suspendedAt                      DateTime?
  sessions                         Session[]
  betSlips                         BetSlip[]
  betSlipItems                     BetSlipItem[]
  bets                             Bet[]
  bankrollTransactions             BankrollTransaction[]
  subscriptions                    Subscription[]
  contentProgress                  UserContentProgress[]
  announcements                    Announcement[]
  announcementReads                AnnouncementRead[]
  badges                           UserBadge[]
  notificationReads                UserNotificationRead[]
  notifications                    Notification[]
  verificationCodes                EmailVerificationCode[]
  resetTokens                      PasswordResetToken[]
  chatConversations                ChatConversation[]
  chatUsage                        ChatUsage[]
  supportConversations             SupportConversation[]
  supportMessagesSent              SupportMessage[]
  pushSubscriptions                PushSubscription[]
  createdAt                        DateTime                @default(now())
  updatedAt                        DateTime                @updatedAt

  @@map("users")
  @@schema("public")
}

model EmailVerificationCode {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@map("email_verification_code")
  @@schema("public")
}

model PasswordResetToken {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String   @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String   @unique
  expiresAt        DateTime
  used             Boolean  @default(false)
  isAdminGenerated Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([userId])
  @@map("password_reset_token")
  @@schema("public")
}

model Announcement {
  id          String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  title       String
  description String
  href        String?
  published   Boolean            @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdById String?            @db.Uuid
  createdBy   User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  reads       AnnouncementRead[]

  @@index([published, publishedAt])
  @@index([createdAt])
  @@map("announcement")
  @@schema("public")
}

// Per-user read tracking for announcements — replaces the frontend
// localStorage dismissed-ids store (doc perf-ux-audit §7.2): survives a
// device change / cache clear, and makes a real unread counter possible.
model AnnouncementRead {
  userId         String       @db.Uuid
  announcementId String       @db.Uuid
  readAt         DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([userId, announcementId])
  @@map("announcement_read")
  @@schema("public")
}

model UserContentProgress {
  id          String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String               @db.Uuid
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentType FormationContentType
  slug        String
  completedAt DateTime
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([userId, contentType, slug])
  @@index([userId])
  @@index([completedAt])
  @@map("user_content_progress")
  @@schema("public")
}

model Session {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, expiresAt])
  @@map("user_session")
  @@schema("public")
}

model BetSlip {
  id        String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String        @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitStake Decimal       @db.Decimal(12, 2)
  type      BetSlipType   @default(SIMPLE)
  items     BetSlipItem[]
  createdAt DateTime      @default(now())

  @@index([userId, createdAt])
  @@map("bet_slip")
  @@schema("public")
}

model BetSlipItem {
  betSlipId     String   @db.Uuid
  betSlip       BetSlip  @relation(fields: [betSlipId], references: [id], onDelete: Cascade)
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  betId         String   @db.Uuid
  bet           Bet      @relation(fields: [betId], references: [id], onDelete: Cascade)
  fixtureId     String   @db.Uuid
  fixture       Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  stakeOverride Decimal? @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  @@id([betSlipId, betId])
  @@index([betSlipId])
  @@index([betId])
  @@index([fixtureId])
  @@map("bet_slip_item")
  @@schema("public")
}

model BankrollTransaction {
  id        String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String                  @db.Uuid
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      BankrollTransactionType
  amount    Decimal                 @db.Decimal(14, 2)
  betId     String?                 @db.Uuid
  bet       Bet?                    @relation(fields: [betId], references: [id])
  note      String?
  createdAt DateTime                @default(now())

  @@index([userId, createdAt])
  @@map("bankroll_transaction")
  @@schema("public")
}

// Proposed weight adjustments from the learning loop.
// Backend decides whether to apply, reject, or freeze (never auto-applied).
model AdjustmentProposal {
  id               String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  triggerBetCount  Int // number of bets that triggered this proposal
  currentWeights   Json // { recentForm: 0.30, xg: 0.30, ... }
  proposedWeights  Json // { recentForm: 0.32, xg: 0.28, ... }
  calibrationError Decimal          @db.Decimal(6, 5)
  status           AdjustmentStatus @default(PENDING)
  appliedAt        DateTime?
  reviewedBy       String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, appliedAt])
  @@index([createdAt])
  @@map("adjustment_proposal")
  @@schema("calibration")
}

// Active suspension of a market triggered automatically by risk rules.
// Only one active suspension per market at a time (enforced at application layer).
model MarketSuspension {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  market      Market
  reason      String // e.g. "ROI -16.3% over 52 bets — auto-suspended"
  triggeredBy String    @default("auto") // "auto" | "manual"
  active      Boolean   @default(true)
  liftedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([market, active])
  @@map("market_suspension")
  @@schema("calibration")
}

// In-app notifications — persisted for dashboard and future mobile app.
// Deux régimes selon userId :
//  - userId null  : broadcast admin/ops (ROI_ALERT, MARKET_SUSPENSION, …),
//    visible par rôle (NotificationService.allowedTypes), lu par utilisateur
//    via UserNotificationRead (plusieurs lecteurs possibles par notif).
//  - userId rempli : notification personnelle (ex. SUBSCRIPTION_*), un seul
//    destinataire possible — read/readAt ci-dessous sont alors la source de
//    vérité directe, UserNotificationRead ne s'applique pas.
model Notification {
  id        String                 @id @default(cuid())
  userId    String?                @db.Uuid
  user      User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  payload   Json? // extra context (market, roi, betCount, etc.)
  read      Boolean                @default(false)
  readAt    DateTime?
  createdAt DateTime               @default(now())
  reads     UserNotificationRead[]

  @@index([read, createdAt])
  @@index([userId, read, createdAt])
  @@map("notification")
  @@schema("public")
}

// Per-user read tracking for system-wide notifications.
model UserNotificationRead {
  userId         String       @db.Uuid
  notificationId String
  readAt         DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([userId, notificationId])
  @@map("user_notification_read")
  @@schema("public")
}

model NationalTeamEloRating {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  teamName   String
  eloCode    String
  rating     Int
  source     String   @default("eloratings.net")
  snapshotAt DateTime
  syncedAt   DateTime @default(now())

  @@unique([teamName, snapshotAt])
  @@index([snapshotAt])
  @@index([teamName, snapshotAt])
  @@map("national_team_elo_rating")
  @@schema("public")
}

// Odds snapshots — scaffolded for Phase 2 (prematch odds integration).
// Not used in MVP.
model OddsSnapshot {
  id         String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fixtureId  String             @db.Uuid
  fixture    Fixture            @relation(fields: [fixtureId], references: [id])
  bookmaker  String
  market     Market
  homeOdds   Decimal?           @db.Decimal(6, 3)
  drawOdds   Decimal?           @db.Decimal(6, 3)
  awayOdds   Decimal?           @db.Decimal(6, 3)
  pick       String? // for non-1X2 markets
  // Decimal(9,3): CORRECT_SCORE odds on obscure scorelines routinely exceed
  // 1000 (already seen up to 800 in prod) and can overflow Decimal(6,3) —
  // 1X2/other markets never come close to this range in practice.
  odds       Decimal?           @db.Decimal(9, 3) // for non-1X2 markets
  source     OddsSnapshotSource @default(PREMATCH)
  snapshotAt DateTime
  createdAt  DateTime           @default(now())

  @@index([fixtureId, snapshotAt])
  // DB-level constraint is UNIQUE NULLS NOT DISTINCT (hand-written in
  // migration 20260815130000): `pick` is NULL for ONE_X_TWO, and a plain
  // unique index treats every NULL as distinct, silently letting ONE_X_TWO
  // duplicates back in. Prisma's own model below doesn't express the NULLS
  // NOT DISTINCT clause — do not let `prisma migrate dev` regenerate this
  // constraint as a plain UNIQUE, it would reopen the ONE_X_TWO race.
  @@unique([fixtureId, bookmaker, market, pick, snapshotAt])
  @@index([snapshotAt])
  @@map("odds_snapshot")
  @@schema("public")
}

// One decision per channel per ModelRun — immutable after creation.
model ChannelDecision {
  id            String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  modelRunId    String                @db.Uuid
  modelRun      ModelRun              @relation(fields: [modelRunId], references: [id])
  channel       StrategyChannel
  status        ChannelDecisionStatus
  reasonCode    String?
  reasonDetails Json?
  // Config/seuils utilisés par la stratégie pour cette décision (audit, doc §2.4/§4.3)
  configVersion String?
  selections    ChannelSelection[]
  createdAt     DateTime              @default(now())

  @@unique([modelRunId, channel])
  @@index([modelRunId])
  @@index([channel, status, createdAt])
  @@map("channel_decision")
  @@schema("public")
}

// One row per selected pick within a ChannelDecision (usually rank=1 only for v1).
model ChannelSelection {
  id                 String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  channelDecisionId  String          @db.Uuid
  channelDecision    ChannelDecision @relation(fields: [channelDecisionId], references: [id])
  market             Market
  pick               String
  probability        Decimal         @db.Decimal(5, 4)
  odds               Decimal?        @db.Decimal(6, 3)
  impliedProbability Decimal?        @db.Decimal(5, 4)
  ev                 Decimal?        @db.Decimal(6, 4)
  qualityScore       Decimal?        @db.Decimal(6, 4)
  rank               Int             @default(1)
  result             BetStatus? // PENDING → WON/LOST/VOID after settlement; Bet.status is financial authority
  settledAt          DateTime?
  bets               Bet[]
  subscriptionEvents SubscriptionEvent[]
  createdAt          DateTime        @default(now())

  // Idempotence du backfill (doc §13) : un rang unique par décision.
  @@unique([channelDecisionId, rank])
  @@index([market, result, createdAt])
  @@map("channel_selection")
  @@schema("public")
}

model Badge {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String
  iconUrl     String?
  createdAt   DateTime    @default(now())
  users       UserBadge[]

  @@map("badge")
